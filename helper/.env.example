# Normally enter these through the extension's Settings; this file is for manual setup.
AZURE_SPEECH_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_SPEECH_KEY=
# The helper installer generates this secret and pairs the extension automatically.
HELPER_TOKEN=

# Optional: only if a video requires your own logged-in browser session.
# YTDLP_COOKIES_BROWSER=brave
# Optional binary directory if you already have FFmpeg and FFprobe:
# FFMPEG_LOCATION=/path/to/bin
# Optional JavaScript runtime for yt-dlp, e.g. node:/path/to/node:
# YTDLP_JS_RUNTIME=node:/path/to/node
# 1.25 means 20% shorter submitted audio, with pitch preserved.
# Production recognition accuracy has not been benchmarked; use 1 for original tempo.
# AUDIO_SPEED=1.25
