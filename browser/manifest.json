{
  "manifest_version": 3,
  "name": "Redline",
  "version": "0.14.4",
  "description": "A fast, ad-free client for YouTube, at youtube.com: Rust-rendered, no bloat. Not affiliated with YouTube or Google.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "key": "",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "nativeMessaging",
    "alarms"
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Redline preferences",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://sponsor.ajay.app/*",
    "https://api.deepgram.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/account*",
        "https://www.youtube.com/premium*",
        "https://www.youtube.com/paid_memberships*",
        "https://www.youtube.com/signin*",
        "https://www.youtube.com/logout*",
        "https://www.youtube.com/redirect*",
        "https://www.youtube.com/s/*",
        "https://www.youtube.com/youtubei/*",
        "https://www.youtube.com/api/*"
      ],
      "exclude_globs": [
        "*yt-native=1*"
      ],
      "css": [
        "client.css",
        "transcripts.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "include_globs": [
        "*yt-native=1*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/account*",
        "https://www.youtube.com/premium*",
        "https://www.youtube.com/paid_memberships*",
        "https://www.youtube.com/signin*",
        "https://www.youtube.com/logout*",
        "https://www.youtube.com/redirect*",
        "https://www.youtube.com/s/*",
        "https://www.youtube.com/youtubei/*",
        "https://www.youtube.com/api/*"
      ],
      "css": [
        "native.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ytc_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  }
}
