# Build output
target/
pkg/
tools/debug-center/target/
node_modules

# Written by the browser into unpacked extensions; written by ./build.sh --dev
extension/_metadata/
extension/build-id.txt

# Debug-center data and logs (they belong in your user data folder, never here)
*.ndjson
incidents*
*.log

.DS_Store

# Google TV app (tv/): build output, the generated client bundle, signing keys (they live in
# ~/.config/lumen-tv/ and are never committed; tv/keys/release.pub is the public key on purpose)
tv/core/target/
tv/shell/src-tauri/target/
tv/shell/src-tauri/bundle/
tv/out/
*.jks
*.keystore
*.pem
*.p12
keystore.properties

# Local screenshots (YTC_SHOTS)
shots/

# The Transcripts helper's settings and data, when it is installed from this checkout (helper/README.md).
/.env
/.data/
/.tools/
/.venv/
